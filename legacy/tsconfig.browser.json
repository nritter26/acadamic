{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "./browser-build"
  },
  "include": ["core-typescript/*.ts"]
}
