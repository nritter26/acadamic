{
  "id": "bookmark-manager",
  "title": "Bookmark Manager",
  "difficulty": "advanced",
  "languages": [
    "javascript",
    "typescript",
    "python"
  ],
  "estimatedMinutes": 45,
  "concepts": [
    "objects",
    "arrays",
    "CRUD operations",
    "filtering",
    "searching",
    "categorization"
  ],
  "description": "Build a bookmark manager that stores, categorizes, searches, and filters bookmarks by category.",
  "steps": [
    {
      "id": 1,
      "title": "Define the bookmark data structure",
      "description": "Create a `bookmarks` array with objects containing `id`, `title`, `url`, and `category`. Add 4 sample bookmarks and log them.",
      "hints": [
        "Bookmark: { id: 1, title: 'Google', url: 'https://google.com', category: 'search' }",
        "Use categories like: 'search', 'social', 'development', 'news'",
        "Log with JSON.stringify"
      ],
      "codeTemplate": {
        "javascript": "<div id=\"bookmarks\"></div>\n<script>\nconst bookmarks = [\n  { id: 1, title: \"Google\", url: \"https://google.com\", category: \"search\" },\n  { id: 2, title: \"GitHub\", url: \"https://github.com\", category: \"development\" },\n  { id: 3, title: \"Stack Overflow\", url: \"https://stackoverflow.com\", category: \"development\" },\n  { id: 4, title: \"Reddit\", url: \"https://reddit.com\", category: \"social\" }\n];\n\nconsole.log(\"Bookmarks:\", bookmarks.length);\nconsole.log(JSON.stringify(bookmarks));\ndocument.getElementById('bookmarks').textContent = bookmarks.length + \" bookmarks\";\n</script>\n",
        "typescript": "<div id=\"bookmarks\"></div>\n<script>\ninterface Bookmark {\n  id: number;\n  title: string;\n  url: string;\n  category: string;\n}\n\nconst bookmarks: Bookmark[] = [\n  { id: 1, title: \"Google\", url: \"https://google.com\", category: \"search\" },\n  { id: 2, title: \"GitHub\", url: \"https://github.com\", category: \"development\" },\n  { id: 3, title: \"Stack Overflow\", url: \"https://stackoverflow.com\", category: \"development\" },\n  { id: 4, title: \"Reddit\", url: \"https://reddit.com\", category: \"social\" }\n];\n\nconsole.log(\"Bookmarks:\", bookmarks.length);\nconsole.log(JSON.stringify(bookmarks));\ndocument.getElementById('bookmarks').textContent = bookmarks.length + \" bookmarks\";\n</script>\n",
        "python": "import json\n\nbookmarks = [\n  {\"id\": 1, \"title\": \"Google\", \"url\": \"https://google.com\", \"category\": \"search\"},\n  {\"id\": 2, \"title\": \"GitHub\", \"url\": \"https://github.com\", \"category\": \"development\"},\n  {\"id\": 3, \"title\": \"Stack Overflow\", \"url\": \"https://stackoverflow.com\", \"category\": \"development\"},\n  {\"id\": 4, \"title\": \"Reddit\", \"url\": \"https://reddit.com\", \"category\": \"social\"}\n]\n\nprint(\"Bookmarks:\", len(bookmarks))\nprint(json.dumps(bookmarks))\n"
      },
      "verification": {
        "test": "output.includes('Bookmarks: 4') && output.includes('google.com') && output.includes('github.com')",
        "successMessage": "Bookmark data structure is ready with 4 bookmarks in different categories!",
        "failureMessage": "Create a bookmarks array with at least 4 bookmarks, each with id, title, url, and category."
      }
    },
    {
      "id": 2,
      "title": "Implement addBookmark function",
      "description": "Write an `addBookmark` function that takes `title`, `url`, and `category`, creates a bookmark with a unique id, and appends it. Log the new bookmark.",
      "hints": [
        "Generate id: Math.max(...bookmarks.map(b => b.id), 0) + 1",
        "Create and push the new bookmark object",
        "Log the newly added bookmark's title and category"
      ],
      "codeTemplate": {
        "javascript": "<div id=\"bookmarks\"></div>\n<script>\nconst bookmarks = [\n  { id: 1, title: \"Google\", url: \"https://google.com\", category: \"search\" }\n];\n\nfunction addBookmark(title, url, category) {\n  \n}\n\naddBookmark(\"MDN Docs\", \"https://developer.mozilla.org\", \"development\");\nconsole.log(\"Total:\", bookmarks.length);\nconsole.log(JSON.stringify(bookmarks[bookmarks.length - 1]));\ndocument.getElementById('bookmarks').textContent = \"Added: \" + bookmarks[bookmarks.length - 1].title;\n</script>\n",
        "typescript": "<div id=\"bookmarks\"></div>\n<script>\ninterface Bookmark {\n  id: number;\n  title: string;\n  url: string;\n  category: string;\n}\n\nconst bookmarks: Bookmark[] = [\n  { id: 1, title: \"Google\", url: \"https://google.com\", category: \"search\" }\n];\n\nfunction addBookmark(title: string, url: string, category: string): Bookmark {\n  \n}\n\naddBookmark(\"MDN Docs\", \"https://developer.mozilla.org\", \"development\");\nconsole.log(\"Total:\", bookmarks.length);\nconsole.log(JSON.stringify(bookmarks[bookmarks.length - 1]));\ndocument.getElementById('bookmarks').textContent = \"Added: \" + bookmarks[bookmarks.length - 1].title;\n</script>\n",
        "python": "bookmarks = [\n  {\"id\": 1, \"title\": \"Google\", \"url\": \"https://google.com\", \"category\": \"search\"}\n]\n\ndef addBookmark(title, url, category):\n  \n\naddBookmark(\"MDN Docs\", \"https://developer.mozilla.org\", \"development\")\nimport json\nprint(\"Total:\", len(bookmarks))\nprint(json.dumps(bookmarks[-1]))\n"
      },
      "verification": {
        "test": "output.includes('Total: 2') && output.includes('MDN')",
        "successMessage": "New bookmarks can be added to the collection!",
        "failureMessage": "addBookmark should create a new bookmark with a unique id and the provided fields."
      }
    },
    {
      "id": 3,
      "title": "Filter bookmarks by category",
      "description": "Write a `filterByCategory` function that takes a `category` string and returns bookmarks in that category. Log the matching bookmark titles.",
      "hints": [
        "Use .filter(): bookmarks.filter(b => b.category === category)",
        "Return the filtered array",
        "Log the count and titles"
      ],
      "codeTemplate": {
        "javascript": "<div id=\"bookmarks\"></div>\n<script>\nconst bookmarks = [\n  { id: 1, title: \"Google\", url: \"https://google.com\", category: \"search\" },\n  { id: 2, title: \"GitHub\", url: \"https://github.com\", category: \"development\" },\n  { id: 3, title: \"MDN\", url: \"https://developer.mozilla.org\", category: \"development\" }\n];\n\nfunction filterByCategory(category) {\n  \n}\n\nconst dev = filterByCategory(\"development\");\nconsole.log(\"Dev bookmarks:\", dev.length);\ndev.forEach(b => console.log(b.title));\ndocument.getElementById('bookmarks').textContent = \"Development: \" + dev.map(b => b.title).join(\", \");\n</script>\n",
        "typescript": "<div id=\"bookmarks\"></div>\n<script>\ninterface Bookmark {\n  id: number;\n  title: string;\n  url: string;\n  category: string;\n}\n\nconst bookmarks: Bookmark[] = [\n  { id: 1, title: \"Google\", url: \"https://google.com\", category: \"search\" },\n  { id: 2, title: \"GitHub\", url: \"https://github.com\", category: \"development\" },\n  { id: 3, title: \"MDN\", url: \"https://developer.mozilla.org\", category: \"development\" }\n];\n\nfunction filterByCategory(category: string): Bookmark[] {\n  \n}\n\nconst dev = filterByCategory(\"development\");\nconsole.log(\"Dev bookmarks:\", dev.length);\ndev.forEach(b => console.log(b.title));\ndocument.getElementById('bookmarks').textContent = \"Development: \" + dev.map(b => b.title).join(\", \");\n</script>\n",
        "python": "bookmarks = [\n  {\"id\": 1, \"title\": \"Google\", \"url\": \"https://google.com\", \"category\": \"search\"},\n  {\"id\": 2, \"title\": \"GitHub\", \"url\": \"https://github.com\", \"category\": \"development\"},\n  {\"id\": 3, \"title\": \"MDN\", \"url\": \"https://developer.mozilla.org\", \"category\": \"development\"}\n]\n\ndef filterByCategory(category):\n  \n\ndev = filterByCategory(\"development\")\nprint(\"Dev bookmarks:\", len(dev))\nfor b in dev:\n  print(b[\"title\"])\n"
      },
      "verification": {
        "test": "output.includes('Dev bookmarks: 2') && output.includes('GitHub') && output.includes('MDN')",
        "successMessage": "Bookmarks can be filtered by category!",
        "failureMessage": "filterByCategory('development') should return GitHub and MDN."
      }
    },
    {
      "id": 4,
      "title": "Search bookmarks by title or URL",
      "description": "Write a `searchBookmarks` function that takes a `query` string and returns bookmarks where the title or URL contains the query (case-insensitive). Log the results.",
      "hints": [
        "Convert both search query and bookmark fields to lowercase",
        "Check: b.title.toLowerCase().includes(query) || b.url.toLowerCase().includes(query)",
        "Return matching bookmarks"
      ],
      "codeTemplate": {
        "javascript": "<div id=\"bookmarks\"></div>\n<script>\nconst bookmarks = [\n  { id: 1, title: \"Google\", url: \"https://google.com\", category: \"search\" },\n  { id: 2, title: \"GitHub\", url: \"https://github.com\", category: \"development\" },\n  { id: 3, title: \"Gmail\", url: \"https://mail.google.com\", category: \"social\" }\n];\n\nfunction searchBookmarks(query) {\n  \n}\n\nconst result = searchBookmarks(\"google\");\nconsole.log(\"Found:\", result.length);\nresult.forEach(b => console.log(b.title));\ndocument.getElementById('bookmarks').textContent = \"Search: \" + result.map(b => b.title).join(\", \");\n</script>\n",
        "typescript": "<div id=\"bookmarks\"></div>\n<script>\ninterface Bookmark {\n  id: number;\n  title: string;\n  url: string;\n  category: string;\n}\n\nconst bookmarks: Bookmark[] = [\n  { id: 1, title: \"Google\", url: \"https://google.com\", category: \"search\" },\n  { id: 2, title: \"GitHub\", url: \"https://github.com\", category: \"development\" },\n  { id: 3, title: \"Gmail\", url: \"https://mail.google.com\", category: \"social\" }\n];\n\nfunction searchBookmarks(query: string): Bookmark[] {\n  \n}\n\nconst result = searchBookmarks(\"google\");\nconsole.log(\"Found:\", result.length);\nresult.forEach(b => console.log(b.title));\ndocument.getElementById('bookmarks').textContent = \"Search: \" + result.map(b => b.title).join(\", \");\n</script>\n",
        "python": "bookmarks = [\n  {\"id\": 1, \"title\": \"Google\", \"url\": \"https://google.com\", \"category\": \"search\"},\n  {\"id\": 2, \"title\": \"GitHub\", \"url\": \"https://github.com\", \"category\": \"development\"},\n  {\"id\": 3, \"title\": \"Gmail\", \"url\": \"https://mail.google.com\", \"category\": \"social\"}\n]\n\ndef searchBookmarks(query):\n  \n\nresult = searchBookmarks(\"google\")\nprint(\"Found:\", len(result))\nfor b in result:\n  print(b[\"title\"])\n"
      },
      "verification": {
        "test": "output.includes('Found: 2') && output.includes('Google') && output.includes('Gmail')",
        "successMessage": "Bookmarks can be found by searching title or URL!",
        "failureMessage": "searchBookmarks('google') should return Google (title matches) and Gmail (URL contains 'google.com')."
      }
    },
    {
      "id": 5,
      "title": "Render bookmark list grouped by category",
      "description": "Write a `renderBookmarks` function that returns a formatted string with bookmarks grouped by category: `\"[search]\\n  1. Google\\n[development]\\n  2. GitHub\"`. Log the result.",
      "hints": [
        "Get unique categories: [...new Set(bookmarks.map(b => b.category))]",
        "For each category, filter bookmarks and render with indentation",
        "Format: '[category]\\n  N. title\\n  N. title\\n'"
      ],
      "codeTemplate": {
        "javascript": "<div id=\"bookmarks\"></div>\n<script>\nconst bookmarks = [\n  { id: 1, title: \"Google\", url: \"https://google.com\", category: \"search\" },\n  { id: 2, title: \"GitHub\", url: \"https://github.com\", category: \"development\" },\n  { id: 3, title: \"MDN\", url: \"https://developer.mozilla.org\", category: \"development\" }\n];\n\nfunction renderBookmarks() {\n  \n}\n\nconsole.log(renderBookmarks());\ndocument.getElementById('bookmarks').innerHTML = \"<pre>\" + renderBookmarks() + \"</pre>\";\n</script>\n",
        "typescript": "<div id=\"bookmarks\"></div>\n<script>\ninterface Bookmark {\n  id: number;\n  title: string;\n  url: string;\n  category: string;\n}\n\nconst bookmarks: Bookmark[] = [\n  { id: 1, title: \"Google\", url: \"https://google.com\", category: \"search\" },\n  { id: 2, title: \"GitHub\", url: \"https://github.com\", category: \"development\" },\n  { id: 3, title: \"MDN\", url: \"https://developer.mozilla.org\", category: \"development\" }\n];\n\nfunction renderBookmarks(): string {\n  \n}\n\nconsole.log(renderBookmarks());\ndocument.getElementById('bookmarks').innerHTML = \"<pre>\" + renderBookmarks() + \"</pre>\";\n</script>\n",
        "python": "bookmarks = [\n  {\"id\": 1, \"title\": \"Google\", \"url\": \"https://google.com\", \"category\": \"search\"},\n  {\"id\": 2, \"title\": \"GitHub\", \"url\": \"https://github.com\", \"category\": \"development\"},\n  {\"id\": 3, \"title\": \"MDN\", \"url\": \"https://developer.mozilla.org\", \"category\": \"development\"}\n]\n\ndef renderBookmarks():\n  \n\nprint(renderBookmarks())\n"
      },
      "verification": {
        "test": "output.includes('[search]') && output.includes('[development]') && output.includes('Google') && output.includes('GitHub')",
        "successMessage": "Bookmarks render grouped by category with proper formatting!",
        "failureMessage": "renderBookmarks should group by category as '[search]\\n  1. Google\\n[development]\\n  2. GitHub\\n  3. MDN'."
      }
    }
  ]
}
