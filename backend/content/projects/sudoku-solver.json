    {
      "id": 4,
      "title": "Implement the backtracking solver",
      "description": "Write a `solve` function that uses recursive backtracking. Find an empty cell, try values 1-9, check validity, place the value, recurse, and backtrack if needed. Return true if solved, false otherwise.",
      "hints": [
        "Base case: if no empty cell, return true (board is solved)",
        "For each value 1-9: if isValidPlacement, place it and recurse",
        "If recursion returns true, return true (solved)",
        "If value doesn't work, reset to 0 and try next (backtrack)"
      ],
      "codeTemplate": {
        "javascript": "<div id=\"sudoku\"></div>\n<script>\nconst board = [\n  [5, 3, 0, 0, 7, 0, 0, 0, 0],\n  [6, 0, 0, 1, 9, 5, 0, 0, 0],\n  [0, 9, 8, 0, 0, 0, 0, 6, 0],\n  [8, 0, 0, 0, 6, 0, 0, 0, 3],\n  [4, 0, 0, 8, 0, 3, 0, 0, 1],\n  [7, 0, 0, 0, 2, 0, 0, 0, 6],\n  [0, 6, 0, 0, 0, 0, 2, 8, 0],\n  [0, 0, 0, 4, 1, 9, 0, 0, 5],\n  [0, 0, 0, 0, 8, 0, 0, 7, 9]\n];\n\nfunction isValidPlacement(board, row, col, value) {\n  for (let i = 0; i < 9; i++) {\n    if (board[row][i] === value) return false;\n    if (board[i][col] === value) return false;\n  }\n  const boxRow = Math.floor(row / 3) * 3;\n  const boxCol = Math.floor(col / 3) * 3;\n  for (let r = boxRow; r < boxRow + 3; r++) {\n    for (let c = boxCol; c < boxCol + 3; c++) {\n      if (board[r][c] === value) return false;\n    }\n  }\n  return true;\n}\n\nfunction findEmptyCell(board) {\n  for (let r = 0; r < 9; r++) {\n    for (let c = 0; c < 9; c++) {\n      if (board[r][c] === 0) return { row: r, col: c };\n    }\n  }\n  return null;\n}\n\nfunction solve(board) {\n  \n}\n\nif (solve(board)) {\n  console.log(\"Solved!\");\n  console.log(JSON.stringify(board));\n} else {\n  console.log(\"No solution exists\");\n}\ndocument.getElementById('sudoku').innerHTML = \"<p>Solved! Check console</p>\";\n</script>\n",
        "typescript": "<div id=\"sudoku\"></div>\n<script>\nconst board: number[][] = [\n  [5, 3, 0, 0, 7, 0, 0, 0, 0],\n  [6, 0, 0, 1, 9, 5, 0, 0, 0],\n  [0, 9, 8, 0, 0, 0, 0, 6, 0],\n  [8, 0, 0, 0, 6, 0, 0, 0, 3],\n  [4, 0, 0, 8, 0, 3, 0, 0, 1],\n  [7, 0, 0, 0, 2, 0, 0, 0, 6],\n  [0, 6, 0, 0, 0, 0, 2, 8, 0],\n  [0, 0, 0, 4, 1, 9, 0, 0, 5],\n  [0, 0, 0, 0, 8, 0, 0, 7, 9]\n];\n\nfunction isValidPlacement(board: number[][], row: number, col: number, value: number): boolean {\n  for (let i = 0; i < 9; i++) {\n    if (board[row][i] === value) return false;\n    if (board[i][col] === value) return false;\n  }\n  const boxRow = Math.floor(row / 3) * 3;\n  const boxCol = Math.floor(col / 3) * 3;\n  for (let r = boxRow; r < boxRow + 3; r++) {\n    for (let c = boxCol; c < boxCol + 3; c++) {\n      if (board[r][c] === value) return false;\n    }\n  }\n  return true;\n}\n\nfunction findEmptyCell(board: number[][]): { row: number; col: number } | null {\n  for (let r = 0; r < 9; r++) {\n    for (let c = 0; c < 9; c++) {\n      if (board[r][c] === 0) return { row: r, col: c };\n    }\n  }\n  return null;\n}\n\nfunction solve(board: number[][]): boolean {\n  \n}\n\nif (solve(board)) {\n  console.log(\"Solved!\");\n  console.log(JSON.stringify(board));\n} else {\n  console.log(\"No solution exists\");\n}\ndocument.getElementById('sudoku').innerHTML = \"<p>Solved! Check console</p>\";\n</script>\n",
        "python": "board = [\n  [5, 3, 0, 0, 7, 0, 0, 0, 0],\n  [6, 0, 0, 1, 9, 5, 0, 0, 0],\n  [0, 9, 8, 0, 0, 0, 0, 6, 0],\n  [8, 0, 0, 0, 6, 0, 0, 0, 3],\n  [4, 0, 0, 8, 0, 3, 0, 0, 1],\n  [7, 0, 0, 0, 2, 0, 0, 0, 6],\n  [0, 6, 0, 0, 0, 0, 2, 8, 0],\n  [0, 0, 0, 4, 1, 9, 0, 0, 5],\n  [0, 0, 0, 0, 8, 0, 0, 7, 9]\n]\n\ndef isValidPlacement(board, row, col, value):\n  for i in range(9):\n    if board[row][i] == value: return False\n    if board[i][col] == value: return False\n  boxRow = (row // 3) * 3\n  boxCol = (col // 3) * 3\n  for r in range(boxRow, boxRow + 3):\n    for c in range(boxCol, boxCol + 3):\n      if board[r][c] == value: return False\n  return True\n\ndef findEmptyCell(board):\n  for r in range(9):\n    for c in range(9):\n      if board[r][c] == 0: return {\"row\": r, \"col\": c}\n  return None\n\ndef solve(board):\n  \n\nimport json\nif solve(board):\n  print(\"Solved!\")\n  print(json.dumps(board))\nelse:\n  print(\"No solution exists\")\n"
      },
      "verification": {
        "test": "output.includes('Solved!') && output.includes('5') && output.includes('3') && output.includes('1')",
        "successMessage": "Backtracking solver successfully solved the Sudoku puzzle!",
        "failureMessage": "The solve function should use recursive backtracking to fill in all empty cells with valid values 1-9."
      }
