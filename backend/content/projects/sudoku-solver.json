        "typescript": "<div id=\"sudoku\"></div>\n<script>\nconst board: number[][] = [\n  [5, 3, 0, 0, 7, 0, 0, 0, 0],\n  [6, 0, 0, 1, 9, 5, 0, 0, 0],\n  [0, 9, 8, 0, 0, 0, 0, 6, 0],\n  [8, 0, 0, 0, 6, 0, 0, 0, 3],\n  [4, 0, 0, 8, 0, 3, 0, 0, 1],\n  [7, 0, 0, 0, 2, 0, 0, 0, 6],\n  [0, 6, 0, 0, 0, 0, 2, 8, 0],\n  [0, 0, 0, 4, 1, 9, 0, 0, 5],\n  [0, 0, 0, 0, 8, 0, 0, 7, 9]\n];\n\nfunction findEmptyCell(board: number[][]): { row: number; col: number } | null {\n  \n}\n\nconst empty = findEmptyCell(board);\nconsole.log(\"First empty:\", JSON.stringify(empty));\ndocument.getElementById('sudoku').textContent = \"First empty cell: (\" + empty!.row + \", \" + empty!.col + \")\";\n</script>\n",
        "python": "board = [\n  [5, 3, 0, 0, 7, 0, 0, 0, 0],\n  [6, 0, 0, 1, 9, 5, 0, 0, 0],\n  [0, 9, 8, 0, 0, 0, 0, 6, 0],\n  [8, 0, 0, 0, 6, 0, 0, 0, 3],\n  [4, 0, 0, 8, 0, 3, 0, 0, 1],\n  [7, 0, 0, 0, 2, 0, 0, 0, 6],\n  [0, 6, 0, 0, 0, 0, 2, 8, 0],\n  [0, 0, 0, 4, 1, 9, 0, 0, 5],\n  [0, 0, 0, 0, 8, 0, 0, 7, 9]\n]\n\ndef findEmptyCell(board):\n  \n\nempty = findEmptyCell(board)\nimport json\nprint(\"First empty:\", json.dumps(empty))\n"
