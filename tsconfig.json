{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["ai/**/*.ts", "server.ts", "sql/**/*.ts", "types.ts", "routes/**/*.ts", "services/**/*.ts", "middleware/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "public/**/*", "data/**/*"]
}
