# ════════════════════════════════════════════════════════════════
# DOGE'S LAB - Environment Configuration
# ════════════════════════════════════════════════════════════════

# ── PORT & RUNTIME ──
PORT=3000
NODE_ENV=development

# ── AI PROVIDER CONFIGURATION ──
# Options: hybrid (default), keyword, openai, anthropic, local
# - hybrid: Keyword cascade + transformers.js (~60MB). Works out of the box.
# - keyword: Free, no API key, uses pattern matching (good for learning)
# - openai: GPT-4, GPT-3.5, etc. (requires API key)
# - anthropic: Claude models (requires API key)
# - local: Ollama, LM Studio, etc. (requires local server running)
AI_PROVIDER=hybrid

# ── OpenAI Configuration ──
# Uncomment and fill in to use OpenAI GPT models
# Get API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_ENDPOINT=https://api.openai.com/v1

# ── Anthropic Configuration ──
# Uncomment and fill in to use Claude models
# Get API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── Local LLM Configuration ──
# Uncomment and fill in to use local models (Ollama, LM Studio, etc.)
# For Ollama: Install from https://ollama.ai, run `ollama serve`, then set:
# LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama2
# (Other popular models: mistral, neural-chat, openchat, etc.)

# ── Database Connections (Optional) ──
# SQLite is built-in with sample data — no configuration needed.
# Uncomment these to enable live PostgreSQL or MySQL execution in the Database tab.
#
# PostgreSQL (psql must be installed):
# PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/mydb
#
# MySQL (mysql CLI must be installed):
# MYSQL_CONNECTION_STRING=mysql://user:password@localhost:3306/mydb

# ── AI Tutor Settings ──
# AI_MAX_TOKENS=1024
# AI_SYSTEM_PROMPT=You are an expert programming tutor...

# ════════════════════════════════════════════════════════════════
# NOTES
# ════════════════════════════════════════════════════════════════
# • Copy this file to .env and fill in your configuration
# • Never commit .env to version control (it contains secrets)
# • Server logs on startup will show which providers are ready
# • Default (keyword AI) works without any API keys

