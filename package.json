{
  "name": "koded",
  "version": "1.0.0",
  "description": "Koded: Interactive Programming Textbook",
  "main": "backend/server.ts",
  "type": "module",
  "scripts": {
    "build:ai": "esbuild backend/ai/responses-data.ts --outdir=public/ai --platform=browser && esbuild legacy/ai/responses.ts legacy/ai/core.ts --outdir=public/ai --platform=browser",
    "build:ai:watch": "esbuild backend/ai/responses-data.ts --outdir=public/ai --platform=browser --watch & esbuild legacy/ai/responses.ts legacy/ai/core.ts --outdir=public/ai --platform=browser --watch",
    "build:browser": "node -e \"require('fs').rmSync('browser-build',{recursive:true,force:true})\" && tsc -p legacy/tsconfig.browser.json",
    "build:browser:watch": "tsc -p legacy/tsconfig.browser.json --watch",
    "start": "npm run build:ai && npm run build:browser && tsx backend/server.ts",
    "dev": "npm run build:ai && npm run build:browser && tsx watch backend/server.ts",
    "build": "npm run build:ai && npm run build:browser && tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:rust": "cd backend/rust && cargo run",
    "dev:svelte": "vite dev",
    "build:svelte": "vite build",
    "preview:svelte": "vite preview",
    "test:svelte": "vitest run"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.18.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^0.14.3",
    "supertest": "^7.2.2",
    "svelte": "^5.56.0",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "fuse.js": "^7.4.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.22.3",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "svelte-motion": "^0.12.2",
    "tailwind-variants": "^3.2.2",
    "uuid": "^14.0.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  }
}
