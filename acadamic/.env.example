# ── AI Provider Configuration ──
# Set AI_PROVIDER to one of: keyword, openai, anthropic, local
# Default: keyword (uses built-in pattern matching, no API key needed)
AI_PROVIDER=keyword

# ── OpenAI ──
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_ENDPOINT=https://api.openai.com/v1

# ── Anthropic ──
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# ── Local (Ollama, LM Studio, etc.) ──
# LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.2

# ── Database Connections (optional) ──
# For live PostgreSQL/MySQL execution in the Database tab.
# SQLite (built-in, no config needed) is always available with sample data.
# PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/mydb
# MYSQL_CONNECTION_STRING=mysql://user:password@localhost:3306/mydb

# ── Shared Settings ──
# AI_MAX_TOKENS=1024
# AI_SYSTEM_PROMPT=Custom system prompt for the AI tutor
