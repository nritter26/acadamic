{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./ai",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["ai/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
